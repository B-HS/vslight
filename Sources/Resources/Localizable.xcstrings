    "소수점 자리": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decimal places"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小数点以下の桁数"
          }
        }
