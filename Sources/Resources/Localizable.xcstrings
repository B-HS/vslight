    },
    "메뉴 막대에 퍼센트 표시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show percentage in menu bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーにパーセントを表示"
          }
        }
      }
    },
    "동작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behavior"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作"
          }
        }
      }
    },
    "프리셋 단축키 사용": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable preset shortcuts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットショートカットを有効にする"
          }
        }
      }
    },
    "마지막 출력 장치 복원": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore last output device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の出力デバイスを復元"
          }
        }
      }
    },
    "시작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動"
          }
        }
      }
    },
    "로그인 시 실행": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        }
      }
    },
    "다시 확인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再確認"
          }
        }
      }
    },
    "앱 재시작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを再起動"
          }
        }
      }
    },
    "시스템 설정에서 승인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve in System Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で承認"
          }
        }
      }
    },
    "설치 위치 확인 필요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check install location"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール場所を確認"
          }
        }
      }
    },
    "시스템 설정 승인 필요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval required"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定での承認が必要"
          }
        }
      }
    },
    "로그인 시 자동 실행 켜짐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login is on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時の自動起動はオン"
          }
        }
      }
    },
    "로그인 시 자동 실행 꺼짐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login is off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時の自動起動はオフ"
          }
        }
      }
    },
    "시스템 설정 > 일반 > 로그인 항목에서 VSLight를 허용하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow VSLight in System Settings > General > Login Items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > 一般 > ログイン項目で VSLight を許可してください。"
          }
        }
      }
    },
    "로그인 항목은 /Applications에 설치된 VSLight에서 등록할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login items can be registered when VSLight is installed in /Applications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目は /Applications にインストールされた VSLight から登録できます。"
          }
        }
      }
    },
    "등록 상태를 다시 읽습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-read the registration status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録状態を再読み込みします。"
          }
        }
      }
    },
    "로그인 항목 변경을 적용하기 위해 앱을 다시 시작합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the app to apply login item changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目の変更を適用するためにアプリを再起動します。"
          }
        }
      }
    },
    "출력 장치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output Device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力デバイス"
          }
        }
      }
    },
    "현재 장치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のデバイス"
          }
        }
      }
    },
    "오디오 다시 감지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan Audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオを再検出"
          }
        }
      }
    },
    "잠자기에서 깨어난 뒤 오디오 상태가 갱신되지 않을 때 사용합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this if audio state is stale after waking from sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ復帰後にオーディオ状態が更新されない場合に使用します。"
          }
        }
      }
    },
    "닫기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "소수점 단위 시스템 볼륨 제어": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise system volume control"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小数点単位のシステム音量調整"
          }
        }
      }
    },
    "프리셋별 전역 단축키": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global shortcuts per preset"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットごとのグローバルショートカット"
          }
        }
      }
    },
    "네이티브 출력 장치 선택": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native output device selection"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ出力デバイス選択"
          }
        }
      }
    },
    "Liquid Glass 인터페이스": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass interface"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass インターフェース"
          }
        }
      }
    },
    "GitHub에서 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View on GitHub"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub で見る"
          }
        }
      }
    },
    "macOS 27 전용 네이티브 볼륨 컨트롤": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native volume control for macOS 27"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 専用のネイティブ音量コントロール"
          }
        }
      }
    },
    "앱별 볼륨에는 가상 오디오 드라이버가 필요합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app volume requires a virtual audio driver"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの音量には仮想オーディオドライバーが必要です"
          }
        }
      }
    },
    "macOS 공개 API는 다른 앱의 출력 볼륨을 직접 낮출 수 없습니다. 프로세스 탭은 캡처 전용이라 감쇠를 적용할 수 없고, 앱별 게인을 적용하려면 HAL 오디오 드라이버를 설치해야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS public APIs cannot lower another app's output volume directly. Process taps are capture-only, so per-app gain requires a HAL audio driver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の公開 API では他のアプリの出力音量を直接下げることはできません。プロセスタップはキャプチャ専用のため、アプリごとのゲインには HAL オーディオドライバーが必要です。"
          }
        }
      }
    },
    "v0.1은 시스템 출력 볼륨과 장치 선택, 프리셋 단축키를 제공하고, 이 화면에서는 현재 오디오를 재생하는 앱만 보여줍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "v0.1 provides system output volume, device selection, and preset shortcuts. This screen lists apps that are currently playing audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "v0.1 ではシステム出力音量、デバイス選択、プリセットショートカットを提供します。この画面には現在オーディオを再生しているアプリが表示されます。"
          }
        }
      }
    },
    "현재 오디오를 재생하는 앱": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps currently playing audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在オーディオを再生しているアプリ"
          }
        }
      }
    },
    "재생 중인 앱이 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps are playing audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオを再生しているアプリはありません。"
          }
        }
      }
    },
    "앱별 볼륨은 드라이버 단계에서 지원합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app volume is supported in the driver phase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの音量はドライバーフェーズで対応します。"
          }
        }
      }
    },
    "알 수 없는 앱": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なアプリ"
          }
        }
      }
    },
    "CoreAudio 오류": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreAudio error"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CoreAudio エラー"
          }
        }
      }
    },
    "오디오 속성 값을 읽지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
