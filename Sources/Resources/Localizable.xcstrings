{
  "sourceLanguage": "ko",
  "strings": {
    "프리셋": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセット"
          }
        }
      }
    },
    "프리셋 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Preset"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットを追加"
          }
        }
      }
    },
    "프리셋 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Presets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットなし"
          }
        }
      }
    },
    "자주 쓰는 볼륨을 저장하고 전역 단축키를 지정하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save frequently used volumes and assign global shortcuts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う音量を保存し、グローバルショートカットを割り当てます。"
          }
        }
      }
    },
    "설정에서 프리셋을 만듭니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create presets in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でプリセットを作成します。"
          }
        }
      }
    },
    "이름": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        }
      }
    },
    "단축키 없음": {
